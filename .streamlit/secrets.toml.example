# Paste into Streamlit Community Cloud -> your app -> Settings -> Secrets.
# Keys must be at the ROOT level (no [section]): Streamlit exposes root-level secrets as
# environment variables, which is how the app reads its settings.
# Never put a real key in this file or anywhere in the repo.

ANTHROPIC_API_KEY = "paste-your-new-key-here"
RAG_LLM = "anthropic"
RAG_ALLOW_UPLOADS = "off"
RAG_DAILY_BUDGET_USD = "0.50"
