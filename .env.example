# Copy to .env. Only needed when RAG_LLM=anthropic.
ANTHROPIC_API_KEY=

# anthropic | fake   (fake = extractive, $0, no network - good for trying the pipeline)
RAG_LLM=fake
RAG_MODEL=claude-haiku-5-5
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
# hybrid = vector + BM25 keyword search merged by rank; vector = vectors only
RAG_RETRIEVAL=hybrid
RAG_CANDIDATES=30
# Decline before any model call when no chunk is this similar (0-1). Provisional.
RAG_MIN_SCORE=0.6
RAG_DATA_DIR=data/raw
RAG_INDEX_DIR=data/index
