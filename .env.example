# Copy to .env. Only needed when RAG_LLM=anthropic.
ANTHROPIC_API_KEY=

# anthropic | fake   (fake = extractive, $0, no network - good for trying the pipeline)
RAG_LLM=fake
RAG_MODEL=claude-haiku-5-5
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
# hybrid = vector + BM25 keyword search merged by rank; vector = vectors only
RAG_RETRIEVAL=hybrid
RAG_CANDIDATES=30
# Decline before any model call when no chunk is this similar (0-1). Provisional.
RAG_MIN_SCORE=0.6
# Re-orders the top candidates by reading question + chunk together (~90MB, ~2s/question
# on CPU). Leave empty to turn it off.
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_RERANK_POOL=25
# Rewrite questions into policy vocabulary before searching (one small Haiku call per
# question, ~$0.0001-0.0002; cached). Only spends money when the anthropic model is in use.
RAG_REWRITE=off
RAG_DATA_DIR=data/raw
RAG_INDEX_DIR=data/index
